// Schema per deploy su Vercel + PostgreSQL (Neon / Supabase / Vercel Postgres)
// NOTA: in locale il progetto usa sqlite, questa e` la versione da GitHub.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  accentColor  String?
  meshyKey     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  projects     Project[]
  modelAssets  ModelAsset[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  state     String   @default("{}")
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  saves     Save[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Save {
  id        String   @id @default(cuid())
  name      String
  state     String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SiteConfig {
  key   String @id
  value String
}

model ModelAsset {
  id        String   @id @default(cuid())
  name      String
  url       String
  size      Int?
  scale     Float?   @default(1.0)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ownerId])
}
